# ── Required ─────────────────────────────────────────────
# PostgreSQL connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Random secret for signing login sessions (32+ characters). Generate: openssl rand -base64 48
AUTH_SECRET=
# Optional: require this code on the one-time owner setup page
SETUP_CODE=

# ── AI (Claude) — voice/text understanding, bill reading, accounting chat ──
ANTHROPIC_API_KEY=
# Model per feature (all default to claude-opus-5-5). Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
AI_MODEL=
AI_MODEL_PARSE=
AI_MODEL_OCR=
AI_MODEL_CHAT=

# ── Optional: server speech-to-text (Google Gemini free tier) ──
# Used only when the phone's own speech recogniser is missing/weak (e.g. Malayalam on some iPhones)
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-flash-latest

# ── Google Sheets sync (service account) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file. Keep the \n sequences.
GOOGLE_PRIVATE_KEY=

# ── Background jobs ──
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron
CRON_SECRET=
