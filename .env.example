# ── Required ─────────────────────────────────────────────
# PostgreSQL connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Random secret for signing login sessions (32+ characters). Generate: openssl rand -base64 48
AUTH_SECRET=
# Optional: require this code on the one-time owner setup page
SETUP_CODE=

# ── AI: voice/text understanding, bill reading, accounting chat ──
# gemini (default, free tier available) or claude (paid per use)
AI_PROVIDER=gemini

# Google Gemini: free key from https://aistudio.google.com/apikey (no card needed for the free tier)
# Free tier: limited requests per minute/day; Google may use free-tier inputs/outputs to improve its products.
GEMINI_API_KEY=
# Models (defaults shown). The fallback is used when the main model is busy or its free quota is used up.
GEMINI_MODEL=gemini-flash-latest
# comma-separated list allowed, e.g. gemini-flash-lite-latest,gemini-3.1-flash-lite ; "none" turns it off
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_PARSE=
GEMINI_MODEL_OCR=
GEMINI_MODEL_CHAT=
GEMINI_STT_MODEL=
# Only if you turn on Google billing: USD per million tokens, so the monthly budget cap counts Gemini spend
GEMINI_PRICE_INPUT=0
GEMINI_PRICE_OUTPUT=0

# Anthropic Claude (optional, paid): set AI_PROVIDER=claude to use it
ANTHROPIC_API_KEY=
# Model per feature (all default to claude-opus-5-5). Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
AI_MODEL=
AI_MODEL_PARSE=
AI_MODEL_OCR=
AI_MODEL_CHAT=

# ── Google Sheets sync (service account) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file. Keep the \n sequences.
GOOGLE_PRIVATE_KEY=

# ── Background jobs ──
# The scheduler (Netlify scheduled function / Vercel Cron / cron-job.org) sends "Authorization: Bearer $CRON_SECRET" to /api/cron
CRON_SECRET=
# Public address of the app, used by the Netlify scheduled function (Netlify sets URL itself; this overrides it)
APP_URL=
# How long /api/cron keeps reading queued bills. Use 15000 on Netlify (30 s function limit); default 200000
CRON_TIME_BUDGET_MS=
